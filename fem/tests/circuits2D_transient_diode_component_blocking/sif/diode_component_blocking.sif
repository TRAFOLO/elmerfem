! Reverse blocking of the FIRST-CLASS diode circuit element,
! "Component Type = String Diode" -- the reverse-bias half of the pair whose
! forward half is circuits2D_transient_diode_component_rectifier.
!
! WHY BOTH HALVES ARE NEEDED
! --------------------------
! The rectifier test pins the forward conduction peak. It cannot tell a diode
! from a small resistor in the reverse half cycle, and it cannot detect Picard
! chatter that happens only while the element is blocking. This case is the SAME
! circuit, run 33 timesteps further, to t = 1.75 T = 8.75 s, where the source
! sits exactly at its negative extremum V = -10 V and the diode is deep in its
! off state. It asserts that
!   (a) blocking actually blocks -- the current is 4.7 decades below the forward
!       peak of 3.946 A, and
!   (b) the leakage is the DESIGNED one, V/(Roff + Rcoil) with the
!       "Diode Off Resistance" set below, not a chattering or half-converged
!       artifact.
!
! WHAT IS DIFFERENT FROM circuits2D_transient_diode_blocking
! ----------------------------------------------------------
! That test builds the same diode out of "Component Type = Resistor" plus a
! MATC "Resistance = Variable "crt v 2"" expression, and therefore needs
! "Export Circuit Variables = Logical True". This one uses the built-in Diode
! component, which reads its own branch voltage from the solver's internal
! relaxed coupled iterate: the export keyword is deliberately absent below.
! Everything else -- circuit topology, diode parameters, sign convention, coil
! calibration, choice of f, relaxation factor, direct linear solver, absolute
! steady-state criterion -- is identical, and
! ../circuits2D_transient_diode_rectifier/sif/diode_rectifier.sif documents all
! of it in full.
!
! REFERENCE VALUE (independent lumped BDF1 solver,
! ../circuits2D_transient_diode_rectifier/diode_reference.py):
!   step 175, t = 8.7500 s, Vsrc = -10.000000 V
!   I_diode = -9.999890537e-05 A,  V_diode = -9.999891 V,  R_diode = 1.0e5 ohm
! Cross-check that the loop really is purely resistive at this operating point:
! the pure Ohm's-law leakage Vsrc/(Roff + Rcoil) = -9.999900001e-05 A differs by
! 1e-6 relative, and the inductive term |wL*I| = 3.0e-4 V is 3e-5 of the source
! voltage, i.e. negligible.
!
! THE REFERENCE NORM IS STATED AS A MAGNITUDE. The leakage current is negative,
! but SaveScalars' pseudo-norm is Solver % Variable % Norm = ABS(value)
! (SaveScalars.F90, SetPseudoNorm), so the number the test framework compares is
! always positive. Stating the reference as -9.99989e-05 does NOT work: the
! comparison then reports 9.99989e-05 vs -9.99989e-05 and, because
! CompareToReferenceSolution silently switches to an ABSOLUTE error whenever
! RefNorm < TINY(), a "Tolerance = 5e-2" would additionally have meant +-0.05 A,
! which even a fully conducting diode would pass. The positive value below with
! a relative 5e-2 tolerance is therefore the intended "leakage is within 5% of
! the designed value" test. The SIGN is not covered by the norm; it is recorded
! in 1381/dat/diode_component_blocking.dat (column "res: i_component(2)") and is
! in any case forced by physics -- a positive resistance cannot pass forward
! current while the source is at -10 V.
!
! Based on circuits2D_transient_variable_resistor by Eelis Takala, Trafotek Oy.
Check Keywords "Warn"
INCLUDE sif/diode_component_blocking_circuit.definitions
INCLUDE 1381/mesh.names
Header 1
   Mesh DB "." "1381"
End

$ V0 = 10        ! source amplitude [V]
$ f  = 0.2       ! source frequency [Hz], chosen so that wL = 2.74*(Rcoil+Ron)
$ T  = 1/f
$ nper = 100     ! timesteps per period
$ dt = T/nper
$ nsteps = 175   ! last step lands on t = 1.75 T, the negative source extremum
$ wrel = 0.10    ! Circuit Variable Relaxation Factor
$ sstol = 1.0e-10

Simulation 1
   Max Output Level = 5
   Coordinate System = Axi symmetric
   Simulation Type = Transient
   Timestepping Method = BDF
   BDF Order = 1
   Timestep Sizes(1) = $ dt
   Timestep Intervals(1) = $ nsteps
!  > 1 enables the within-timestep Picard loop over the nonlinear resistance.
   Steady State Max Iterations = 100
!  Guards against a premature exit while the field is nearly zero (blocking
!  phase and the two zero crossings), where a single coupled iteration can look
!  converged before the nonlinearity has been iterated at all.
   Steady State Min Iterations = 3
End
Solver 1
   Exec Solver = Always
   Equation = Circuits
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamics"
!  NOTE: "Export Circuit Variables" is deliberately NOT set -- the Diode
!  component reads its own branch voltage internally.
   Circuit Variable Relaxation Factor = Real $ wrel
End
Solver 2
   Equation = "Mag"
   Variable = A
   Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"
   NonLinear System Relaxation Factor=1
   Export Lagrange Multiplier = Logical True
!  Direct solve: with an iterative solver the blocking-phase field norm (2.5e-7)
!  is at the level of the iterative solve's own noise, and the coupled loop then
!  never converges in the reverse half cycle. See the rectifier sif.
   Linear System Solver = Direct
   Linear System Direct Method = UMFPACK
!  Absolute, because the field norm spans 9.9e-3 (conduction) down to ~0 at the
!  source zero crossing at t = 5.000 s, which lands exactly on a grid point.
   Steady State Convergence Tolerance = $ sstol
   Steady State Convergence Absolute = Logical True
End
Solver 3 ! Result output
   Exec Solver = Never
   Equation = "ResultOutput"
   Procedure = "ResultOutputSolve" "ResultOutputSolver"
   Output File Name = 1381-results
   Vtu format = Logical True
   Save Geometry Ids = Logical True
End
Solver 4
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 5
   Exec Solver = After Timestep
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = 1381/dat/diode_component_blocking.dat
!  No "Variable N" entries: with no circuit export there are no "crt i"/"crt v"
!  mesh variables. The asserted quantity is the solved circuit dof published by
!  CircuitsOutput.
   Show Norm Name = String "res: i_component(2)"
End
Equation 1
   Active Solvers(2) = 2 3
End
Equation 2
   Active Solvers(3) = 1 2 3
End
Material 1
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
End
Material 2
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
End
Material 3
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 1e7
End
Body 1
   Name = Core
   Target Bodies(6) = 1 2 3 4 5 6
   Equation = 1
   Material = 1
End
Body 2
   Name = air
   Target Bodies(2) = 9 7
   Equation = 1
   Material = 2
End
Body 3
   Name = test 1
   Target Bodies = 8
   Equation = 2
   Material = 3
End
Component 1
   Name = String test inductor
   Master Bodies = Integer 3
   Coil Type = String stranded
   Number of Turns = Real 1000
   Resistance = Real 1.0
End
Component 2
   Name = String diode
!  The first-class diode. No Master Bodies, no MATC, no exported variable.
   Component Type = String Diode
   Diode Forward Voltage = Real 0.0
   Diode On Resistance = Real 0.1
   Diode Off Resistance = Real 1.0e5
   Diode Smoothing Voltage = Real 0.1
End
Body Force 1
   Name = "Circuit"
   testsource = Variable time
     Real MATC "V0*sin(2*pi*f*tx)"
End
Boundary Condition 1
   Target Boundaries(4) = $ center0 center1 center2 center3
   A = Real 0
End
Boundary Condition 2
   Target Boundaries(2) = 4 6
   Name = "Air Gap"
   Air Gap = logical True
   Air Gap Length = Real 0.0001
   Air Gap Relative Permeability = Real 1
End
Boundary Condition 3
   Target Boundaries(7) = 10 13 14 17 18 19 27
   Infinity BC = Logical True
End

! The A field here is the field of a 1e-4 A leakage current, i.e. 4 decades
! below the conduction norm, so a looser tolerance than the 1e-5 default is
! used for it; the physics assertion is the one below it.
Solver 2 :: Reference Norm = 2.50012780E-07
Solver 2 :: Reference Norm Tolerance = Real 1E-04
! |I_diode| at t = 8.75 s from the independent lumped BDF1 reference -- the same
! number the MATC-based gate test asserts. 5e-2 relative = 5% of the leakage.
Solver 5 :: Reference Norm = 9.9998905371E-05
Solver 5 :: Reference Norm Tolerance = Real 5E-02
