! DEV-1606: two H-B curves with the same knots and values, an ordinary and a monotone cubic
! spline, in the energy of the static layered law (a table per curve). The model of
! mgdyn_laminate_layered_transient_hb with its air layer also a layered stack, of the same steel
! and stacking factor but the monotone spline: the two curves differ in their cubic coefficients
! only, so a table keyed on knots and values would give the second stack the first one's energy.
! These norms are those of the same model with the second stacking factor 1e-12 larger, which
! keeps the tables apart in any case. 10 steps.
! Norms at the last step: the laminate stack loss (W, solver 3), the magnetic field energy
! (solver 4) and the mean B_x of the second stack (solver 5).

Check Keywords "Warn"

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = Real 5e-05
  Timestep Intervals = Integer 10
  Output Intervals = 0
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Material = 1
  stack = Logical True
End

Body 2
  Equation = 1
  Material = 3
  surface air = Logical True
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 1
  H-B Curve = Variable "dummy"
    Real Cubic
    0 0
    0.1 30.899
    0.15 36.569
    0.2 40.234
    0.25 43.39
    0.3 46.336
    0.35 49.202
    0.4 52.065
    0.45 54.979
    0.5 57.993
    0.55 61.15
    0.6 64.497
    0.65 68.086
    0.7 71.977
    0.75 76.246
    0.8 80.987
    0.85 86.321
    0.9 92.413
    0.95 99.485
    1 107.857
    1.05 117.998
    1.1 130.627
    1.15 146.912
    1.2 168.866
    1.25 200.253
    1.3 248.855
    1.35 332.757
    1.4 497.965
    1.45 845.999
    1.5 1475.927
    1.55 2375.23
    1.6 3514.3
    1.65 4909.532
    1.7 6615.108
    1.75 8720.736
    1.799 11300
    1.85 14740.502
    1.875 16796.475
    1.9 19161.832
    1.925 21899.293
    1.95 25085.277
    1.975 28811.658
    2 33186.406
    2.025 38331.902
    2.05 44379.312
    2.075 51457.668
    2.1 59677.8
    2.125 69114.05
    2.15 79789.57
    2.175 91671.4
    2.2 104677.414
    2.225 118692.19
    2.374196083 237384.38
    2.821784331 593460.95
    9.535608059 5934609.5
    End
  Electric Conductivity = 0.0
  Laminate Stack Model = String "layered"
  Laminate Stacking Factor = Real 0.96
  Laminate Normal(3) = Real 0 0 1
  Laminate Thickness = Real 0.00035
  Laminate Stack Conductivity = Real 2000000.0
  Harmonic Loss Linear Coefficient = Real 0.0032616604064702307
  Harmonic Loss Linear Frequency Exponent = Real 1.4639789711704392
  Harmonic Loss Linear Exponent = Real 1.8129000545217033
  Harmonic Loss Quadratic Coefficient = Real 0.403008846378
  Harmonic Loss Quadratic Frequency Exponent = Real 2.0
  Harmonic Loss Quadratic Exponent = Real 2.0
End

Material 3
  H-B Curve = Variable "dummy"
    Real Cubic Monotone
    0 0
    0.1 30.899
    0.15 36.569
    0.2 40.234
    0.25 43.39
    0.3 46.336
    0.35 49.202
    0.4 52.065
    0.45 54.979
    0.5 57.993
    0.55 61.15
    0.6 64.497
    0.65 68.086
    0.7 71.977
    0.75 76.246
    0.8 80.987
    0.85 86.321
    0.9 92.413
    0.95 99.485
    1 107.857
    1.05 117.998
    1.1 130.627
    1.15 146.912
    1.2 168.866
    1.25 200.253
    1.3 248.855
    1.35 332.757
    1.4 497.965
