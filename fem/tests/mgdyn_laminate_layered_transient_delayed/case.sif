! DEV-1606: a solver that first runs at a later step of a reloaded model. The tilted stack of
! mgdyn_laminate_layered_transient_reload (M300-35A curve, 500 Hz, stacking factor 0.96, Laminate
! Normal (0.6, 0, 0.8)) in a one-step simulation and, after RUN (the solver not initialised
! again), a second one of two timesteps with 0.8 of the drive, whose first the AV solver skips
! ('Skip First Timestep'). Its first solve is step 2, after the last ladder step of the first
! simulation, and the solver's own step count goes on: only their offset tells the new simulation
! apart. Its ladders start from its field, and its norms are those of a restart from the first
! simulation's result at 1e-5 s with 0.8 of the drive (to 13 digits). With the ladders of the
! first simulation kept, the loss is 48 % lower and the largest 'Proximity Loss' 52 % lower.
! Norms at the end of the second simulation: the laminate stack loss (W, solver 3), the magnetic
! field energy (solver 4), the air layer B_x (solver 5) and the largest 'Proximity Loss' (W/m^3,
! solver 6).

Check Keywords "Warn"

$ amp = 1.0

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Transient
  Timestepping Method = Implicit Euler
  Timestep Sizes = Real 1e-05
  Timestep Intervals = Integer 1
  Output Intervals = 0
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Initial Condition = 1
  Material = 1
  stack = Logical True
End

Body 2
  Equation = 1
  Initial Condition = 1
  Material = 2
  surface air = Logical True
End

Initial Condition 1
  ! the scalar edge entry makes SetInitialConditions read the components
  AV {e} = Real 0.0
  AV {e} 1 = Real 0.0
  AV {e} 2 = Variable Coordinate 3
    Real MATC "-1.0906741672998588*amp*tx"
  AV {e} 3 = Real 0.0
  AV = Real 0.0
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 1
  H-B Curve = Variable "dummy"
    Real
    0 0
    0.1 30.899
    0.15 36.569
    0.2 40.234
    0.25 43.39
    0.3 46.336
    0.35 49.202
    0.4 52.065
    0.45 54.979
    0.5 57.993
    0.55 61.15
    0.6 64.497
    0.65 68.086
    0.7 71.977
    0.75 76.246
    0.8 80.987
    0.85 86.321
    0.9 92.413
    0.95 99.485
    1 107.857
    1.05 117.998
    1.1 130.627
    1.15 146.912
    1.2 168.866
    1.25 200.253
    1.3 248.855
    1.35 332.757
    1.4 497.965
    1.45 845.999
    1.5 1475.927
    1.55 2375.23
    1.6 3514.3
    1.65 4909.532
    1.7 6615.108
    1.75 8720.736
    1.799 11300
    1.85 14740.502
    1.875 16796.475
    1.9 19161.832
    1.925 21899.293
    1.95 25085.277
    1.975 28811.658
    2 33186.406
    2.025 38331.902
    2.05 44379.312
    2.075 51457.668
    2.1 59677.8
    2.125 69114.05
    2.15 79789.57
    2.175 91671.4
    2.2 104677.414
    2.225 118692.19
    2.374196083 237384.38
    2.821784331 593460.95
    9.535608059 5934609.5
    End
  Electric Conductivity = 0.0
  Laminate Stack Model = String "layered"
  Laminate Stacking Factor = Real 0.96
  Laminate Normal(3) = Real 0.6 0 0.8
  Laminate Thickness = Real 0.00035
  Laminate Stack Conductivity = Real 2000000.0
  Harmonic Loss Linear Coefficient = Real 0.0032616604064702307
  Harmonic Loss Linear Frequency Exponent = Real 1.4639789711704392
  Harmonic Loss Linear Exponent = Real 1.8129000545217033
  Harmonic Loss Quadratic Coefficient = Real 0.403008846378
  Harmonic Loss Quadratic Frequency Exponent = Real 2.0
  Harmonic Loss Quadratic Exponent = Real 2.0
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Exported Variable 1 = -dofs 1 -elem "Proximity Loss"
  Linear System Symmetric = True
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Use Tree Gauge = Logical False
  Mumps Diagonal Regularization = Real 1e-09
  Newton-Raphson Iteration = Logical True
  Nonlinear System Relaxation Factor = Real 1.0
  Nonlinear System Max Iterations = 20
  Nonlinear System Abort Not Converged = Logical True
  Nonlinear System Convergence Tolerance = 1e-07
  Nonlinear System Convergence Measure = String "flux density"
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Current Density = Logical True
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True
  Separate Magnetic Energy = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-8
End

Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = transient.dat
  Parallel Reduce = Logical True
  Variable 1 = Time
  Variable 2 = Magnetic Flux Density e 1
  Operator 2 = body int mean
  Mask Name 2 = String "stack"
  Variable 3 = Magnetic Flux Density e 1
  Operator 3 = body int mean
  Mask Name 3 = String "surface air"
  Show Norm Index = 8
End

Solver 4
  Equation = "SaveEnergy"
  Procedure = "SaveData" "SaveScalars"
  Filename = energy.dat
  Show Norm Index = 3
End

Solver 5
  Equation = "SaveSurfaceField"
  Procedure = "SaveData" "SaveScalars"
  Filename = surface.dat
  Parallel Reduce = Logical True
  Variable 1 = Magnetic Flux Density e 1
  Operator 1 = body int mean
  Mask Name 1 = String "surface air"
  Show Norm Index = 1
End

Solver 6
  Equation = "SaveProximityLoss"
  Procedure = "SaveData" "SaveScalars"
  Filename = proximity.dat
  Variable 1 = Proximity Loss
  Operator 1 = max
  Show Norm Index = 1
End

Boundary Condition 1
  Target Boundaries(1) = 1
  AV {e} = Real 0.0
  AV = Real 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  AV {e} 1 = Real 0.0
  AV {e} 2 = Variable Coordinate 3, Time
    Real MATC "-1.0906741672998588*amp*cos(3141.592653589793*tx(1))*tx(0)"
  AV {e} 3 = Real 0.0
End

RUN

! the second simulation: two timesteps, of which the AV solver skips the first,
! 0.8 of the drive
$ amp = 0.8
Simulation :: Timestep Intervals = Integer 2
Solver 1 :: Skip First Timestep = Logical True

Solver 3 :: Reference Norm = Real 7.09132180E-02
Solver 3 :: Reference Norm Tolerance = Real 1.0e-6
Solver 4 :: Reference Norm = Real 1.28044052E-05
Solver 4 :: Reference Norm Tolerance = Real 1.0e-6
Solver 5 :: Reference Norm = Real 4.34396391E-03
Solver 5 :: Reference Norm Tolerance = Real 1.0e-6
Solver 6 :: Reference Norm = Real 1.08159631E+07
Solver 6 :: Reference Norm Tolerance = Real 1.0e-6

RUN
