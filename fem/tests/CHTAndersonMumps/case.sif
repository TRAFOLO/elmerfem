! Differentially heated air cavity: L=0.0213 m, delta T=10 K, Ra approximately 1e4.
! No-slip walls; hot left, cold right, insulated top and bottom.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "cavity"
End

Simulation
  Coordinate System = String "Cartesian 2D"
  Simulation Type = String "Steady State"
  Steady State Max Iterations = Integer 60
  Steady State Anderson = Logical True
  Steady State Anderson Depth = Integer 3
  Steady State Anderson After = Integer 3
  Steady State Anderson Relaxation = Real 0.8
  Max Output Level = Integer 5
  Post File = "case.vtu"
End

Constants
  Gravity(4) = Real 0 -1 0 9.81
End

Body 1
  Target Bodies(1) = Integer 1
  Equation = Integer 1
  Material = Integer 1
  Body Force = Integer 1
  Initial Condition = Integer 1
End

Equation 1
  Active Solvers(2) = Integer 1 2
  Convection = String "Computed"
End

Material 1
  Density = Real 1.2
  Viscosity = Real 1.8e-5
  Heat Capacity = Real 1005
  Heat Conductivity = Real 0.0255
  Heat Expansion Coefficient = Real 0.003333333333333333
  Reference Temperature = Real 300
End

Body Force 1
  Boussinesq = Logical True
End

Initial Condition 1
  Velocity 1 = Real 0
  Velocity 2 = Real 0
  Pressure = Real 0
  Temperature = Variable Coordinate 1
    Real MATC "305-10*tx/0.0213"
End

Solver 1
  Equation = String "Navier-Stokes"
  Procedure = "FlowSolve" "FlowSolver"
  Variable = String "Flow Solution[Velocity:2 Pressure:1]"
  Stabilization Method = String "Stabilized"
  Nonlinear System Max Iterations = Integer 1
  Nonlinear System Convergence Tolerance = Real 1e-6
  Nonlinear System Relaxation Factor = Real 0.7
  Steady State Convergence Measure = String "solution"
  Steady State Convergence Tolerance = Real 1e-6
  Linear System Solver = String "Direct"
  Linear System Direct Method = String "MUMPS"
  Linear System Refactorize = Logical True
  Mumps Reuse Analysis = Logical True
End

Solver 2
  Equation = String "Heat Equation"
  Procedure = "HeatSolve" "HeatSolver"
  Variable = String "Temperature"
  Algebraic Upwinding = Logical True
  Nonlinear System Max Iterations = Integer 1
  Nonlinear System Convergence Tolerance = Real 1e-6
  Steady State Convergence Measure = String "solution"
  Steady State Convergence Tolerance = Real 1e-6
  Linear System Solver = String "Direct"
  Linear System Direct Method = String "MUMPS"
  Linear System Refactorize = Logical True
  Mumps Reuse Analysis = Logical True
End

Boundary Condition 1
  Target Boundaries(1) = Integer 4
  Velocity 1 = Real 0
  Velocity 2 = Real 0
  Temperature = Real 305
End

Boundary Condition 2
  Target Boundaries(1) = Integer 2
  Velocity 1 = Real 0
  Velocity 2 = Real 0
  Temperature = Real 295
End

Boundary Condition 3
  Target Boundaries(2) = Integer 1 3
  Velocity 1 = Real 0
  Velocity 2 = Real 0
End

Boundary Condition 4
  Target Coordinates(1,2) = Real 0 0
  Pressure = Real 0
End

Solver 2 :: Reference Norm = Real 300.01572
