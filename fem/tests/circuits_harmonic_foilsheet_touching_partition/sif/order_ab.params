! inner winding first; the outer one is component 2
Component 1  !---- inner winding
  Name = String inner
  Master Bodies(1) = Integer 1
  Coil Type = String foil sheet
  Number of Turns = Real 10
  Foil Thickness = Real 0.8e-3
  Fill Factor = Real 0.8
  Sheet Conductivity = Real 58e6
  Sheet Cells = Integer 10
  Sheet Segments = Integer 4
  Sheet Sublayers = Integer 1
  Electrode Boundaries(2) = Integer 2 3
  Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
  Homogenization Model = Logical True
End
Component 2  !---- outer winding
  Name = String outer
  Master Bodies(1) = Integer 2
  Coil Type = String foil sheet
  Number of Turns = Real 10
  Foil Thickness = Real 0.8e-3
  Fill Factor = Real 0.8
  Sheet Conductivity = Real 58e6
  Sheet Cells = Integer 10
  Sheet Segments = Integer 4
  Sheet Sublayers = Integer 1
  Electrode Boundaries(2) = Integer 4 5
  Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
  Homogenization Model = Logical True
End
Solver 9 :: Show Norm Name = String "res: r_component(2)"
Solver 9 :: Reference Norm = Real 4.186637080400E-03
Solver 9 :: Reference Norm Tolerance = Real 1E-8
Solver 10 :: Reference Norm = Real 6.251361854100E-03
Solver 10 :: Reference Norm Tolerance = Real 1E-6
