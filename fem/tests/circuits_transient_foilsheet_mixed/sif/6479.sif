! A foil sheet stacked along alpha and a flat wire sheet stacked along beta in
! one transient model, each in its own circuit (DEV-1520). The two stacking
! directions carry the reluctivity ladder on different in-plane directions, so
! the AV solver needs the Xi states of all three; it used to declare only two
! and stop at the first assembly with 'needs "Xi Beta"'. The flat wire sheet has
! a lower ladder order, so the shared Gamma state is declared with the larger
! order and the flat wire sheet uses its first dofs.
! The mesh is circuits_transient_foilsheet plus a disjoint copy shifted 500 mm
! along x, made by runtest.cmake, so each coil reproduces its single-coil run.
! On 4 partitions the mesh is cut along x and every partition holds the
! elements of one coil only.
Check Keywords "Warn"
INCLUDE sif/6479-circuits.definitions
INCLUDE 6479/mesh.names
! The copy of the model made by runtest.cmake: bodies +3, boundaries +12.
$ B_core = 4
$ B_air = 5
$ B_A1 = 6
$ B_xy0 = 13
$ B_A1_alpha0 = 14
$ B_A1_alpha1 = 15
$ B_A1_gamma1 = 16
$ B_A1_gamma0 = 17
$ B_coreface_xy = 18
$ B_A1_beta1 = 19
$ B_A1_beta0 = 21
Header 1
   Mesh DB "." "6479x2"
End
Constants 1
   Permittivity of Vacuum = 8.8542e-12
End
Initial Condition 1
   A {e} = Real 0
   A  = Real 0
End
Simulation 1
   Max Output Level = 3
   Coordinate System = Cartesian 3D
   Coordinate Mapping(3) = 1 2 3
   Coordinate Scaling = 0.001
   Simulation Type = Transient
   Timestepping Method = BDF
   BDF Order = 2
   Timestep intervals = 8
   Timestep Sizes = 6.25e-4
   Steady State Max Iterations = 1
End
Solver 1  !---- DirectionSolver, DirectionSolver
   Exec Solver = Before all
   Procedure = "DirectionSolver" "DirectionSolver"
   Linear System Solver = Iterative
   Linear System Iterative Method = BiCGStab
   Linear System Max Iterations = 5000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
   Equation = Direction Alpha
   Variable =  Alpha
End
Solver 2  !---- DirectionSolver, DirectionSolver
   Exec Solver = Before all
   Procedure = "DirectionSolver" "DirectionSolver"
   Linear System Solver = Iterative
   Linear System Iterative Method = BiCGStab
   Linear System Max Iterations = 5000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
   Equation = Direction Beta
   Variable =  Beta
End
Solver 3  !---- CoordinateTransform, RotMSolver
   Exec Solver = Before All
   Equation = Transformation matrix
   Procedure = "CoordinateTransform" "RotMSolver"
   Variable = -nooutput Dummy
   Optimize Bandwidth = False
   Polar Decomposition Determinant Tolerance = Real 1.0e-9
   Polar Decomposition Max Iterations = Integer 100
   Exported Variable 1 = -nooutput RotM E[RotM E:9]
   Exported Variable 2 = -nooutput Alpha Vector E[Alpha Vector E:3]
   Exported Variable 3 = -nooutput Beta Vector E[Beta Vector E:3]
   Exported Variable 4 = -nooutput Gamma Vector E[Gamma Vector E:3]
   Discontinuous Galerkin = True
End
Solver 4  !---- WPotentialSolver, Wsolve
   Exec Solver = Before All
   Procedure = "WPotentialSolver" "Wsolve"
   Equation = "Wire direction"
   Variable = W
   Linear System Solver = Iterative
   Linear System Iterative Method = CG
   Linear System Max Iterations = 10000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
End
Solver 5  !---- CircuitsAndDynamics, CircuitsAndDynamics
   Exec Solver = Always
   Equation = Circuits
   Variable = X
   No Matrix = Logical True
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamics"
End
Solver 6  !---- MagnetoDynamics, WhitneyAVSolver
   Exec Solver = Always
   Equation = "MGDynamics"
   Variable = "A"
   Procedure = "MagnetoDynamics" "WhitneyAVSolver"
   NonLinear System Relaxation Factor=1
   Export Lagrange Multiplier = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = BicgstabL
   Linear System preconditioning = none
   Linear System Convergence Tolerance = 1.0e-11
   Linear System Abort Not Converged = False
   Linear System Max Iterations = 3000
   Linear System Residual Output = 1000
   BicgstabL polynomial degree = 6
   Steady State Convergence Tolerance = 1e-08
End
Solver 7  !---- MagnetoDynamics, MagnetoDynamicsCalcFields
   Exec Solver = Always
   Equation = "MGDynamicsCalc"
   Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
   Linear System Symmetric = True
   Potential Variable = String "A"
   Calculate Current Density = Logical True
   Loss Estimation = Logical True
   Linear System Solver = "Iterative"
   Linear System Preconditioning = None
   Linear System Residual Output = 1000
   Linear System Max Iterations = 5000
   Linear System Iterative Method = CG
   Steady State Convergence Tolerance = 1e-6
   Linear System Convergence Tolerance = 1.0e-10
End
Solver 8  !---- CircuitsAndDynamics, CircuitsOutput
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 9  !---- SaveData, SaveScalars
   Exec Solver = After timestep
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = 6479/dat/6479.dat
   ! Column 3 is res: sheet proximity loss, the reluctivity ladder loss of
   ! both sheets computed from their Xi states and summed over the partitions.
   Show Norm Index = Integer 3
End
Equation 1
   Active Solvers(2) = 6 7
End
Equation 2
   Active Solvers(7) = 1 2 3 4 5 6 7
End
Material 1  !---- iron: generic
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
End
Material 2  !---- air: generic
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
   Relative Permittivity = 1
End
Material 3  !---- aluminium: generic
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 36e6
End
Body 1  !---- core
   Name = core
   Target Bodies(1) = $ core
   Equation = 1
   Material = 1
   Initial Condition = 1
End
Body 2  !---- air
   Name = air
   Target Bodies(1) = $ air
   Equation = 1
   Material = 2
   Initial Condition = 1
End
Body 3  !---- foil
   Name = foil
   Target Bodies(1) = $ A1
   Equation = 2
   Material = 3
   Initial Condition = 1
   Body Force = 1
   Alpha reference (3) = Real 1 0 0
   Beta reference (3) = Real 0 1 0
End
Body 4  !---- core of the flat wire copy
   Name = core flat wire
   Target Bodies(1) = $ B_core
   Equation = 1
   Material = 1
   Initial Condition = 1
End
Body 5  !---- air of the flat wire copy
   Name = air flat wire
   Target Bodies(1) = $ B_air
   Equation = 1
   Material = 2
   Initial Condition = 1
End
Body 6  !---- flat wire
   Name = flat wire
   Target Bodies(1) = $ B_A1
   Equation = 2
   Material = 3
   Initial Condition = 1
   Body Force = 1
   Alpha reference (3) = Real 1 0 0
   Beta reference (3) = Real 0 1 0
End
Component 1  !---- foil
   Name = String foil
   Master Bodies = Integer 3
   Coil Type = String foil sheet
   Number of Turns = Real 8
   Sheet Cells = Integer 8
   Sheet Segments = Integer 4
   Electrode Boundaries(2) = Integer 4 5
   ! t/delta = 1.5 at 50 Hz: both ladders carry a visible share, so the Xi
   ! states are load-bearing.
   Foil Thickness = Real 12.6e-3
   Fill Factor = Real 0.5
   Sheet Conductivity = Real 72e6
   Homogenization Model = Logical True
   Homogenization Ladder Order = Integer 4
   Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
End
Component 2  !---- flat wire
   Name = String flat wire
   Master Bodies = Integer 6
   Coil Type = String foil sheet
   Stacking Direction = String beta
   Number of Turns = Real 8
   Sheet Cells = Integer 8
   Sheet Segments = Integer 4
   Electrode Boundaries(2) = Integer 11 12
   Foil Thickness = Real 12.6e-3
   Fill Factor = Real 0.5
   Sheet Conductivity = Real 72e6
   Homogenization Model = Logical True
   Homogenization Ladder Order = Integer 3
   Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
End
Body Force 1  !---- Circuit
   Name = "Circuit"
   S1: Frequency = Real 50.0
   S1: Phase = Real 0.0
   S1: Harmonic Content (1,2) = Real 1 10
   S1 = Variable time
     Real Procedure "HarmonicSignals" "Source"
   S2: Frequency = Real 50.0
   S2: Phase = Real 1.5707963267948966
   S2: Harmonic Content (1,2) = Real 1 5
   S2 = Variable time
     Real Procedure "HarmonicSignals" "Source"
End
Boundary Condition 1  !---- BCn Flux Parallel
   Name = BCn Flux Parallel
   Target Boundaries(2) = $ coreface_xy xy0
   A {e} = Real 0
End
Boundary Condition 2  !---- Alpha0
   Name = Alpha0
   Target Boundaries = $ A1_alpha0
   Alpha = Real 0
End
Boundary Condition 3  !---- Alpha1
   Name = Alpha1
   Target Boundaries = $ A1_alpha1
   Alpha = Real 1
End
Boundary Condition 4  !---- ground
   Name = ground
   Target Boundaries = $ A1_gamma1
   W = Real 0
   A {e} = Real 0
End
Boundary Condition 5  !---- current in foil winding
   Name = current in foil winding
   Target Boundaries = $ A1_gamma0
   W = Real 1
   A {e} = Real 0
End
Boundary Condition 6  !---- Beta1
   Name = Beta1
   Target Boundaries = $ A1_beta1
   Beta = Real 1
End
Boundary Condition 7  !---- Beta0
   Name = Beta0
   Target Boundaries = $ A1_beta0
   Beta = Real 0
End
Boundary Condition 8  !---- BCn Flux Parallel, flat wire copy
   Name = BCn Flux Parallel flat wire
   Target Boundaries(2) = $ B_coreface_xy B_xy0
   A {e} = Real 0
End
Boundary Condition 9  !---- Alpha0, flat wire copy
   Name = Alpha0 flat wire
   Target Boundaries = $ B_A1_alpha0
   Alpha = Real 0
End
Boundary Condition 10  !---- Alpha1, flat wire copy
   Name = Alpha1 flat wire
   Target Boundaries = $ B_A1_alpha1
   Alpha = Real 1
End
Boundary Condition 11  !---- ground, flat wire copy
   Name = ground flat wire
   Target Boundaries = $ B_A1_gamma1
   W = Real 0
   A {e} = Real 0
End
Boundary Condition 12  !---- current in flat wire winding
   Name = current in flat wire winding
   Target Boundaries = $ B_A1_gamma0
   W = Real 1
   A {e} = Real 0
End
Boundary Condition 13  !---- Beta1, flat wire copy
   Name = Beta1 flat wire
   Target Boundaries = $ B_A1_beta1
   Beta = Real 1
End
Boundary Condition 14  !---- Beta0, flat wire copy
   Name = Beta0 flat wire
   Target Boundaries = $ B_A1_beta0
   Beta = Real 0
End
Solver 9 :: Reference Norm = Real 1.96544501E-02
Solver 9 :: Reference Norm Tolerance = Real 1E-05
$fprintf( stderr, "TEST CASE 1\n");
RUN
