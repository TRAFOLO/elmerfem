! DEV-1667: WallLawCheck calls the HybridWallLaw functions on a face of boundary
! condition 1 for every wall formula and compares them with the formulas written out.

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "block"
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
End

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = "WallLawCheck"
  Procedure = "WallLawCheck" "WallLawCheck"
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Hybrid Wall Law = Integer 1
End
