! Nonlinear (solution-dependent) lumped circuit element in a transient
! circuit-coupled magnetodynamics run.
!
! Topology (identical to circuits2D_transient_variable_resistor):
!   ideal 10 V source -- stranded FEM coil (component 1) -- resistor (component 2)
! all in series.
!
! Component 1 is given an explicit "Resistance = Real 1.0", which makes
! Add_stranded skip the sigma-based FEM resistance contribution, so the coil
! contributes exactly 1 ohm plus its inductance.
! Component 2 is a lumped resistor whose resistance depends on its OWN current
!   R2(I) = 1 + 0.05*I^2
! through the exported circuit variable "crt i 2" (Export Circuit Variables).
!
! Index mapping of the exported variables (verified at runtime with
! Max Output Level = 20): "crt i" holds only the COMPONENT currents, in the
! order the components appear in the circuit definitions -- the bare source
! current i_testsource is not exported. Hence
!   crt i 1 = i_component(1) (coil),  crt i 2 = i_component(2) (resistor).
!
! At DC steady state the inductive term vanishes and the loop current solves
!   10 = I*(1 + 1 + 0.05*I^2)   <=>   0.05*I^3 + 2*I - 10 = 0
!   =>  I* = 3.7165775870513285 (A)
! which is what the SaveScalars pseudo-norm below asserts.
!
! Calibration (linear cross-check that was run before baking the reference
! norms, kept here as a comment): running the very same case with
! "Resistance = Real 1.0" on component 2 gives, per timestep,
!   4.8830136  4.9972628  4.9999360  4.9999985  5.0000000
! i.e. exactly the expected DC current I = 10/(1+1) = 5 A (this also confirms
! that the explicit coil resistance replaces, and is not added to, the
! sigma-based FEM resistance), and the last two steps agree to
! |dI/I| = 3e-7 < 1e-6, so the run is at DC well within the assertion
! tolerance below.
!
! Based on circuits2D_transient_variable_resistor by Eelis Takala, Trafotek Oy.
Check Keywords "Warn"
INCLUDE sif/nonlinear_resistor_circuit.definitions
INCLUDE 1381/mesh.names
Header 1
   Mesh DB "." "1381"
End
! Timestep >> the L/R time constant of the loop (about 1.2 s), so that a few
! BDF1 steps take the current to its DC value.
$ stepsize = 50
Simulation 1
   Max Output Level = 5
   Coordinate System = Axi symmetric
   Simulation Type = Transient
   Timestepping Method = BDF
   BDF Order = 1
   Timestep Sizes(1) = $ stepsize
   Timestep Intervals(1) = 5
!  > 1 enables the within-timestep Picard loop over the nonlinear resistance
   Steady State Max Iterations = 30
End
Solver 1
   Exec Solver = Always
   Equation = Circuits
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamics"
!  Publish the circuit currents/voltages as mesh variables ("crt i", "crt v")
!  so that component keywords may depend on them.
   Export Circuit Variables = Logical True
End
Solver 2
   Equation = "Mag"
   Variable = A
   Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"
   NonLinear System Relaxation Factor=1
   Export Lagrange Multiplier = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = bicgstab
   Linear System Convergence Tolerance = 1.e-10
   Linear System Max Iterations = 3000
   Linear System Residual Output = 10
   Linear System Abort not Converged = False
   Linear System ILUT Tolerance=1e-8
   linear system preconditioning = circuit
   BicgStabL Polynomial Degree = 2
   Steady State Convergence Tolerance = 1e-08
End
Solver 3
   Equation = CompB
   Variable = -nooutput temp
   Exported Variable 1 = B[B:2]
   Target Variable="A"
   Procedure = "MagnetoDynamics2D" "bSolver"
   Discontinuous Galerkin = Logical True
   Average Within Materials = True
   Constant Bulk Matrix = True
   Linear System Solver = Iterative
   Linear System Iterative Method = BicgstabL
   Linear System Symmetric = True
   Linear System Max Iterations = 100
   Linear System Residual Output = 10
   Linear System Preconditioning = ILU0
   Linear System Convergence Tolerance = 1e-8
End
Solver 4 ! Result output
   Exec Solver = Never
   Equation = "ResultOutput"
   Procedure = "ResultOutputSolve" "ResultOutputSolver"
   Output File Name = 1381-results
   Vtu format = Logical True
   Save Geometry Ids = Logical True
End
Solver 5
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 6
   Exec Solver = After Timestep
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = 1381/dat/nonlinear_resistor.dat
!  The resistor current; asserted against the analytic root below.
   Variable 1 = String "crt i 2"
   Show Norm Index = Integer 1
End
Equation 1
   Active Solvers(3) = 2 3 4
End
Equation 2
   Active Solvers(4) = 1 2 3 4
End
Material 1
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
End
Material 2
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
End
Material 3
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 1e7
End
Body 1
   Name = Core
   Target Bodies(6) = 1 2 3 4 5 6
   Equation = 1
   Material = 1
End
Body 2
   Name = air
   Target Bodies(2) = 9 7
   Equation = 1
   Material = 2
End
Body 3
   Name = test 1
   Target Bodies = 8
   Equation = 2
   Material = 3
End
Component 1
   Name = String test inductor
   Master Bodies = Integer 3
   Coil Type = String stranded
   Number of Turns = Real 1000
!  Explicit coil resistance: suppresses the FEM sigma-based resistance so that
!  the DC loop resistance is exactly 1 ohm + R2(I).
   Resistance = Real 1.0
End
Component 2
   Name = String nonlinear resistor
   Component Type = String Resistor
!  Solution-dependent resistance: depends on this component's own current,
!  which is the second exported component current ("crt i 2").
   Resistance = Variable "crt i 2"
     Real MATC "1.0 + 0.05*tx*tx"
End
Body Force 1
   Name = "Circuit"
   testsource = Real 10
End
Boundary Condition 1
   Target Boundaries(4) = $ center0 center1 center2 center3
   A = Real 0
End
Boundary Condition 2
   Target Boundaries(2) = 4 6
   Name = "Air Gap"
   Air Gap = logical True
   Air Gap Length = Real 0.0001
   Air Gap Relative Permeability = Real 1
End
Boundary Condition 3
   Target Boundaries(7) = 10 13 14 17 18 19 27
   Infinity BC = Logical True
End

Solver 2 :: Reference Norm = 9.29202076E-03
! Analytic root of 0.05*I^3 + 2*I - 10 = 0.
Solver 6 :: Reference Norm = 3.7165775870513285
Solver 6 :: Reference Norm Tolerance = Real 1E-04
