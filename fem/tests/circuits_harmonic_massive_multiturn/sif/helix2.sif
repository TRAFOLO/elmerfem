! Closed (full loop) solid conductor that makes more than one turn: a two turn
! helix of 3x3 mm aluminium wire, radius 12 mm, pitch 7 mm, closed on itself by
! a return path outside the helix tube. The cut plane of the CoilSolver crosses
! it twice per branch, once per turn, and "Single Coil Cut" keeps the Dirichlet
! layer on one of the two crossings, the piece with the largest global node
! index, so that the cut potential ramps once over the whole wire and the turns
! carry one series current. Without it every crossing is pinned separately and
! the run stops on the one crossing check of a closed massive coil.
! "Number of Turns" is not given: it does not enter the normalization of a coil
! that is cut once.
! Reference: a StatCurrentSolver DC solve of the same conductor with a 0.1 mm
! gap in the lower stub gives R_dc = 7.187522E-04 Ohm. The source current is
! sqrt(2) A of amplitude, so "res: eddy current power" is I_rms^2 R = R at 50 Hz,
! where the skin depth of 11.9 mm makes the AC resistance the DC one: the pinned
! norm is 0.04 % above R_dc.
! Mesh: gmsh, see the DEV-1525 validation scripts.
Check Keywords "Warn"
INCLUDE sif/helix2-circuits.definitions
INCLUDE helix2/mesh.names
Header 1
   Mesh DB "." "helix2"
End
Constants 1
   Permittivity of Vacuum = 8.8542e-12
End
Initial Condition 1
   A re {e} = Real 0
   A im {e} = Real 0
End
Simulation 1
   Max Output Level = 5
   Coordinate System = Cartesian 3D
   Coordinate Mapping(3) = 1 2 3
   Simulation Type = Steady
   Steady State Max Iterations = 1
   BDF Order = 1
   Output Intervals = 1
   Angular Frequency = 314.159265359
End
Solver 1  !---- CoilSolver, CoilSolver
   Exec Solver = Before All
   Equation = "CoilSolver"
   Procedure = "CoilSolver" "CoilSolver"
   Steady State Convergence Tolerance = 1e-06
   Nonlinear System Consistent Norm = Logical True
   Linear System Solver = "Iterative"
   Linear System Preconditioning = ILU2
   Linear System Max Iterations = 5000
   Linear System Convergence Tolerance = 1e-10
   Linear System Iterative Method = BiCGStab
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
   Coil Closed = Logical True
   Narrow Interface = Logical True
   Single Coil Cut = Logical True
End
Solver 2  !---- CircuitsAndDynamics, CircuitsAndDynamicsHarmonic
   Exec Solver = Always
   Equation = Circuits
   Variable = X
   No Matrix = Logical True
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamicsHarmonic"
End
Solver 3  !---- MagnetoDynamics, WhitneyAVHarmonicSolver
   Exec Solver = Always
   Equation = "MGDynamics"
   Variable = "A[A re:1 A im:1]"
   Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
   Angular Frequency = 314.159265359
   Export Lagrange Multiplier = Logical True
   Linear System Symmetric = Logical True
   Linear System Complex = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = BicgstabL
   Linear System preconditioning = Circuit
   Linear System Convergence Tolerance = 1.e-8
   Linear System Max Iterations = 8000
   Linear System Residual Output = 2000
   BicgStabL Polynomial Degree = 4
   Steady State Convergence Tolerance = 1e-08
End
Solver 4  !---- MagnetoDynamics, MagnetoDynamicsCalcFields
   Exec Solver = Always
   Equation = "MGDynamicsCalc"
   Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
   Linear System Symmetric = True
   Potential Variable = String "A"
   Calculate Current Density = Logical True
   Calculate Joule Heating = Logical True
   Separate Magnetic Energy = Logical True
   Loss Estimation = Logical True
   Steady State Convergence Tolerance = 0
   Linear System Solver = "Iterative"
   Linear System Preconditioning = None
   Linear System Residual Output = 2000
   Linear System Max Iterations = 5000
   Linear System Iterative Method = CG
   Linear System Convergence Tolerance = 1.0e-10
End
Solver 5  !---- CircuitsAndDynamics, CircuitsOutput
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 6  !---- SaveData, SaveScalars
   Exec Solver = After timestep
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = helix2/dat/helix2.dat
   Show Norm Index = Integer 1
End
Equation 1
   Active Solvers(2) = 3 4
End
Equation 2
   Active Solvers(6) = 1 2 3 4 5 6
End
Material 1  !---- aluminium: generic
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 36e6
End
Material 2  !---- air: generic
   Name = air
   Relative Permeability = 1
   Electric Conductivity = 0
End
Body 1  !---- A1
   Name = A1
   Target Bodies(1) = $ A1
   Equation = 2
   Material = 1
   Initial Condition = 1
   Body Force = 1
End
Body 2  !---- air
   Name = air
   Target Bodies(1) = $ air
   Equation = 1
   Material = 2
   Initial Condition = 1
End
Component 1  !---- A1
   Name = String A1
   Master Bodies = Integer 1
   Coil Type = String massive
   Coil Closed = Logical True
   Coil Normal(3) = Real 0 0 1
   Coil Center(3) = Real 0 0 0.007
   Circuit Equation Voltage Factor = Real 1
End
Body Force 1  !---- Circuit
   Name = "Circuit"
   S1 Re = Real 1.41421356237
   S1 Im = Real 0
End
Boundary Condition 1  !---- outer
   Name = outer
   Target Boundaries(1) = $ outer
   A re {e} = Real 0
   A im {e} = Real 0
End
Solver 6 :: Reference Norm = Real 7.1904011E-04
Solver 6 :: Reference Norm Tolerance = Real 1E-4
$fprintf( stderr, "TEST CASE 1\n");
RUN
