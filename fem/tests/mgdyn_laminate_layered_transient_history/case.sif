! DEV-1606: the history paths of the transient 'layered' laminate stack. The stack and the drive of
! mgdyn_laminate_layered_transient (its mesh; mu_r 2000, stacking factor 0.96, 2 kHz, order 6) with a
! cosine flux from a nonzero initial field, B_x = B0 cos(omega t), held at B0 before (the ladder
! states start from it, as steady; the scalar 'AV {e}' entry of the initial condition is needed for
! SetInitialConditions to read its components); two timestep sizes, 6 steps of 1.25e-5 s and then 4
! of 2.5e-5 s (variable-step BDF2 of the field and of the ladder at the change), short against the
! slowest ladder pole (about 5 steps) so that the start still shows at the end; and two solves per
! step (Steady State Min/Max Iterations = 2: the second one redoes the step from the states committed
! at its start and gives the result of the first, so the norms are those of one solve per step).
! The loss density of each element also goes into an elemental 'Proximity Loss' (its integral is the
! stack loss to 1e-9, checked on a VTU output; the 'int' of SaveScalars is not used, it skips
! elements of an elemental field).
! Norms at the last step: the laminate stack loss (W, solver 3), the magnetic field energy (solver 4),
! the air layer B_x (solver 5) and the largest 'Proximity Loss' (W/m^3, solver 6).

Check Keywords "Warn"

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes(2) = Real 1.25e-05 2.5e-05
  Timestep Intervals(2) = Integer 6 4
  Output Intervals(2) = Integer 0 0
  Steady State Max Iterations = 2
  Steady State Min Iterations = 2
End

Body 1
  Equation = 1
  Initial Condition = 1
  Material = 1
  stack = Logical True
End

Body 2
  Equation = 1
  Initial Condition = 1
  Material = 2
  surface air = Logical True
End

Initial Condition 1
  ! the scalar edge entry makes SetInitialConditions read the components
  AV {e} = Real 0.0
  AV {e} 1 = Real 0.0
  AV {e} 2 = Variable Coordinate 3
    Real MATC "-0.41950503355704694*tx"
  AV {e} 3 = Real 0.0
  AV = Real 0.0
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 1
  Relative Permeability = Real 2000.0
  Electric Conductivity = 0.0
  Laminate Stack Model = String "layered"
  Laminate Stacking Factor = Real 0.96
  Laminate Normal(3) = Real 0 0 1
  Laminate Thickness = Real 0.00035
  Laminate Stack Conductivity = Real 2000000.0
  Harmonic Loss Linear Coefficient = Real 0.0
  Harmonic Loss Linear Frequency Exponent = Real 1.0
  Harmonic Loss Linear Exponent = Real 2.0
  Harmonic Loss Quadratic Coefficient = Real 0.403008846378
  Harmonic Loss Quadratic Frequency Exponent = Real 2.0
  Harmonic Loss Quadratic Exponent = Real 2.0
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Exported Variable 1 = -dofs 1 -elem "Proximity Loss"
  Linear System Symmetric = True
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Use Tree Gauge = Logical False
  Mumps Diagonal Regularization = Real 1e-09
  Newton-Raphson Iteration = Logical True
  Nonlinear System Relaxation Factor = Real 1.0
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1e-07
  Nonlinear System Convergence Measure = String "flux density"
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Current Density = Logical True
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True
  Separate Magnetic Energy = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-8
End

Solver 3
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = transient.dat
  Parallel Reduce = Logical True
  Variable 1 = Time
  Variable 2 = Magnetic Flux Density e 1
  Operator 2 = body int mean
  Mask Name 2 = String "stack"
  Variable 3 = Magnetic Flux Density e 1
  Operator 3 = body int mean
  Mask Name 3 = String "surface air"
  Show Norm Index = 8
End

Solver 4
  Equation = "SaveEnergy"
  Procedure = "SaveData" "SaveScalars"
  Filename = energy.dat
  Show Norm Index = 3
End

Solver 5
  Equation = "SaveSurfaceField"
  Procedure = "SaveData" "SaveScalars"
  Filename = surface.dat
  Parallel Reduce = Logical True
  Variable 1 = Magnetic Flux Density e 1
  Operator 1 = body int mean
  Mask Name 1 = String "surface air"
  Show Norm Index = 1
End

Solver 6
  Equation = "SaveProximityLoss"
  Procedure = "SaveData" "SaveScalars"
  Filename = proximity.dat
  Variable 1 = Proximity Loss
  Operator 1 = max
  Show Norm Index = 1
End

Boundary Condition 1
  Target Boundaries(1) = 1
  AV {e} = Real 0.0
  AV = Real 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  AV {e} 1 = Real 0.0
  AV {e} 2 = Variable Coordinate 3, Time
    Real LUA "-0.41950503355704694*math.cos(12566.370614359172*tx[1])*tx[0]"
  AV {e} 3 = Real 0.0
End

Solver 3 :: Reference Norm = Real 4.92494317E-03
Solver 3 :: Reference Norm Tolerance = Real 1.0e-6
Solver 4 :: Reference Norm = Real 1.56965514E-07
Solver 4 :: Reference Norm Tolerance = Real 1.0e-6
Solver 5 :: Reference Norm = Real 3.03316757E-04
Solver 5 :: Reference Norm Tolerance = Real 1.0e-6
Solver 6 :: Reference Norm = Real 6.75420778E+05
Solver 6 :: Reference Norm Tolerance = Real 1.0e-6
