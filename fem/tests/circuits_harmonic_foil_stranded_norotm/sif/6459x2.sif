! DEV-1559: a foil winding must not inherit "Without RotM" from a stranded coil.
! The model is the harmonic foil winding of circuits_harmonic_foil, twice. The
! original (bodies 1-3, boundaries 1-12) carries a stranded coil with
! "Without RotM = True"; the copy made by runtest.cmake (bodies 4-6, boundaries
! 13-24, 500 mm along x) carries the foil winding, same settings as in
! circuits_harmonic_foil. The copy is appended after the original, so the W
! potential solver assembles every foil element after the stranded ones. It once
! kept the stranded flag and solved the foil W potential without the RotM
! rotation of the conductivity tensor. The two coils do not touch, so the foil
! current, voltage and Joule loss below must equal the circuits_harmonic_foil
! results; the Reference Norms at the end pin the foil copy only.
Check Keywords "Warn"
INCLUDE sif/6459x2-circuits.definitions
INCLUDE 6459/mesh.names
! The copy of the model made by runtest.cmake: bodies +3, boundaries +12.
$ core2 = 4
$ air2 = 5
$ A2 = 6
$ xy02 = 13
$ A2_alpha0 = 14
$ A2_alpha1 = 15
$ A2_gamma1 = 16
$ A2_gamma0 = 17
$ coreface_xy2 = 18
$ A2_beta1 = 19
$ A2_beta0 = 21
Header 1
   Mesh DB "." "6459x2"
End
Constants 1
   Permittivity of Vacuum = 8.8542e-12
End
Initial Condition 1
   A re {e} = Real 0
   A im {e} = Real 0
End
Simulation 1
   Max Output Level = 3
   Coordinate System = Cartesian 3D
   Coordinate Mapping(3) = 1 2 3
   Coordinate Scaling = 0.001
   Simulation Type = Steady
   Steady State Max Iterations = 1
   BDF Order = 1
   Output Intervals = 1
   Angular Frequency = 314.159265359
End
Solver 1  !---- DirectionSolver, DirectionSolver
   Exec Solver = Before all
   Procedure = "DirectionSolver" "DirectionSolver"
   Linear System Solver = Iterative
   Linear System Iterative Method = BiCGStab
   Linear System Max Iterations = 5000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
   Equation = Direction Alpha
   Variable =  Alpha
End
Solver 2  !---- DirectionSolver, DirectionSolver
   Exec Solver = Before all
   Procedure = "DirectionSolver" "DirectionSolver"
   Linear System Solver = Iterative
   Linear System Iterative Method = BiCGStab
   Linear System Max Iterations = 5000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
   Equation = Direction Beta
   Variable =  Beta
End
Solver 3  !---- CoordinateTransform, RotMSolver
   Exec Solver = Before All
   Equation = Transformation matrix
   Procedure = "CoordinateTransform" "RotMSolver"
   Variable = -nooutput Dummy
   Optimize Bandwidth = False
   Polar Decomposition Determinant Tolerance = Real 1.0e-9
   Polar Decomposition Max Iterations = Integer 100
   Exported Variable 1 = -nooutput RotM E[RotM E:9]
   Exported Variable 2 = -nooutput Alpha Vector E[Alpha Vector E:3]
   Exported Variable 3 = -nooutput Beta Vector E[Beta Vector E:3]
   Exported Variable 4 = -nooutput Gamma Vector E[Gamma Vector E:3]
   Discontinuous Galerkin = True
End
Solver 4  !---- WPotentialSolver, Wsolve
   Exec Solver = Before All
   Procedure = "WPotentialSolver" "Wsolve"
   Equation = "Wire direction"
   Variable = W
   Linear System Solver = Iterative
   Linear System Iterative Method = CG
   Linear System Max Iterations = 10000
   Linear System Convergence Tolerance = 1.0e-10
   Linear System Abort Not Converged = True
   Linear System Residual Output = 1000
End
Solver 5  !---- CircuitsAndDynamics, CircuitsAndDynamicsHarmonic
   Exec Solver = Always
   Equation = Circuits
   Variable = X
   No Matrix = Logical True
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamicsHarmonic"
End
Solver 6  !---- MagnetoDynamics, WhitneyAVHarmonicSolver
   Exec Solver = Always
   Equation = "MGDynamics"
   Variable = "A[A re:1 A im:1]"
   Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
   Angular Frequency = 314.159265359
   Export Lagrange Multiplier = Logical True
   Linear System Symmetric = Logical True
   Linear System Complex = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = BicgstabL
   Linear System preconditioning = Circuit
   Linear System Convergence Tolerance = 1.e-10
   Linear System Max Iterations = 5000
   Linear System Residual Output = 1000
   BicgStabL Polynomial Degree = 4
   Steady State Convergence Tolerance = 1e-08
End
Solver 7  !---- MagnetoDynamics, MagnetoDynamicsCalcFields
   Exec Solver = Always
   Equation = "MGDynamicsCalc"
   Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
   Linear System Symmetric = True
   Potential Variable = String "A"
   Calculate Current Density = Logical True
   Loss Estimation = Logical True
   Steady State Convergence Tolerance = 0
   Linear System Solver = "Iterative"
   Linear System Preconditioning = None
   Linear System Residual Output = 1000
   Linear System Max Iterations = 5000
   Linear System Iterative Method = CG
   Steady State Convergence Tolerance = 1e-6
   Linear System Convergence Tolerance = 1.0e-10
End
Solver 8  !---- CircuitsAndDynamics, CircuitsOutput
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 9  !---- ResultOutputSolve, ResultOutputSolver
   Exec Solver = After timestep
   !Exec Solver = Never
   Equation = "ResultOutput"
   Procedure = "ResultOutputSolve" "ResultOutputSolver"
   Output File Name = 6459x2-results
   Vtu format = Logical True
   Save Geometry Ids = Logical True
End
Solver 10  !---- SaveData, SaveScalars
   Exec Solver = Always
   Equation = "sv10"
   Procedure = "SaveData" "SaveScalars"
   Filename = 6459/dat/foil_v_re.dat
   Show Norm Name = String "res: v_component(2) re"
End
Solver 11  !---- SaveData, SaveScalars
   Exec Solver = Always
   Equation = "sv11"
   Procedure = "SaveData" "SaveScalars"
   Filename = 6459/dat/foil_v_im.dat
   Show Norm Name = String "res: v_component(2) im"
End
Solver 12  !---- SaveData, SaveScalars
   Exec Solver = Always
   Equation = "sv12"
   Procedure = "SaveData" "SaveScalars"
   Filename = 6459/dat/foil_joule.dat
   Show Norm Name = String "component 2: res: joule loss"
End
Equation 1
   Active Solvers(2) = 6 7
End
Equation 2
   Active Solvers(7) = 1 2 3 4 5 6 \
                       7
End
Equation 3
   Active Solvers(4) = 4 5 6 7
End
Material 1  !---- iron: generic
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
   Relative Permittivity = 1e100
End
Material 2  !---- air: generic
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
   Relative Permittivity = 1
End
Material 3  !---- aluminium: generic
   Name = aluminium
   Relative Permeability = 1
   Relative Permittivity = 1e100
   Electric Conductivity = 36e6
End
Body 1  !---- core
   Name = core
   Target Bodies(1) = $ core
   Equation = 1
   Material = 1
   Initial Condition = 1
End
Body 2  !---- air
   Name = air
   Target Bodies(1) = $ air
   Equation = 1
   Material = 2
   Initial Condition = 1
End
Body 3  !---- A1, the stranded coil
   Name = A1
   Target Bodies(1) = $ A1
   Equation = 3
   Material = 3
   Initial Condition = 1
   Body Force = 1
End
Body 4  !---- core of the copy
   Name = core2
   Target Bodies(1) = $ core2
   Equation = 1
   Material = 1
   Initial Condition = 1
End
Body 5  !---- air of the copy
   Name = air2
   Target Bodies(1) = $ air2
   Equation = 1
   Material = 2
   Initial Condition = 1
End
Body 6  !---- A2, the foil winding
   Name = A2
   Target Bodies(1) = $ A2
   Equation = 2
   Material = 3
   Initial Condition = 1
   Body Force = 1
   Alpha reference (3) = Real 1 0 0
   Beta reference (3) = Real 0 1 0
End
Component 1  !---- A1, stranded
   Name = String A1
   Master Bodies = Integer 3
   Coil Type = String stranded
   Without RotM = Logical True
   Number of Turns = Real 8
   Electrode Boundaries(2) = Integer 4 5
   Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
End
Component 2  !---- A2, foil winding as in circuits_harmonic_foil
   Name = String A2
   Master Bodies = Integer 6
   Coil Type = String foil winding
   Number of Turns = Real 8
   Electrode Area = Real 0.01 ! This should be automated in the future and invoked with the "Electrode Boundaries" key
   Foil Winding Voltage Polynomial Order = Integer 1
   Coil Thickness = Real 0.1
   Foil Layer Thickness = Real 0.0112
   Circuit Equation Voltage Factor = Real 0.5 !symmetry (half of the problem is solved)
   Calculate Magnetic Losses = Logical True
End
Body Force 1  !---- Circuit
   Name = "Circuit"
   S1 Re = Real $ cos(0.0*pi/3) * 1.41421356237
   S1 Im = Real $ sin(0.0*pi/3) * 1.41421356237
   S2 Re = Real $ cos(0.0*pi/3) * 1.41421356237
   S2 Im = Real $ sin(0.0*pi/3) * 1.41421356237
End
Boundary Condition 1  !---- BCn Flux Parallel
   Name = BCn Flux Parallel
   Target Boundaries(2) = $ coreface_xy xy0
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 2  !---- ground of the stranded coil
   Name = ground
   Target Boundaries = $ A1_gamma1
   W = Real 0
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 3  !---- current in the stranded coil
   Name = current in stranded coil
   Target Boundaries = $ A1_gamma0
   W = Real 1
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 4  !---- BCn Flux Parallel of the copy
   Name = BCn Flux Parallel 2
   Target Boundaries(2) = $ coreface_xy2 xy02
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 5  !---- Alpha0
   Name = Alpha0
   Target Boundaries = $ A2_alpha0
   Body 6: Alpha = Real 0 ! This boundary condition can be given for each body
End
Boundary Condition 6  !---- Alpha1
   Name = Alpha1
   Target Boundaries = $ A2_alpha1
   Body 6: Alpha = Real 1
End
Boundary Condition 7  !---- ground
   Name = ground 2
   Target Boundaries = $ A2_gamma1
   W = Real 0
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 8  !---- current in foil winding
   Name = current in foil winding
   Target Boundaries = $ A2_gamma0
   W = Real 1
   A re {e} = Real 0
   A im {e} = Real 0
End
Boundary Condition 9  !---- Beta1
   Name = Beta1
   Target Boundaries = $ A2_beta1
   Body 6: Beta = Real 1
End
Boundary Condition 10  !---- Beta0
   Name = Beta0
   Target Boundaries = $ A2_beta0
   Body 6: Beta = Real 0
End
! Foil winding of the copy only: the real and imaginary circuit voltage and the
! Joule loss of the component. They equal the circuits_harmonic_foil results
! (9.4143E-04, 3.0720, 3.3285E-04), so the foil winding does not see the
! stranded coil. With the leak the real voltage and the Joule loss were 39 %
! too high and the imaginary voltage 0.036 % too low.
Solver 10 :: Reference Norm = Real 9.41432122E-04
Solver 10 :: Reference Norm Tolerance = Real 1E-3
Solver 11 :: Reference Norm = Real 3.07196670E+00
Solver 11 :: Reference Norm Tolerance = Real 1E-5
Solver 12 :: Reference Norm = Real 3.32846578E-04
Solver 12 :: Reference Norm Tolerance = Real 1E-3
$fprintf( stderr, "TEST CASE 1\n");
RUN
