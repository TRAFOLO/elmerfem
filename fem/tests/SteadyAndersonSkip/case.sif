! Flow through a channel past a block on its floor, and a tracer that the flow carries from
! the inlet to the outlet. The steady-state acceleration extrapolates the flow field; the tracer solver stays
! out of it (Steady State Anderson Skip) and keeps the field its own solve left.
! runtest.cmake also runs the case with that solver on the first velocity component: a field
! kept out must not be a part of an accelerated one, and the run has to stop. On two ranks it
! runs the case as it is, and with a flag that one rank sets and the other does not: every
! rank has to keep the same solvers out, and that run has to stop as well.
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "channel"
End

Simulation
  Coordinate System = Cartesian 2D
  Simulation Type = Steady State
  Steady State Max Iterations = 5
  Steady State Anderson = Logical True
  Steady State Anderson After = Integer 1
  Max Output Level = 5
End

Body 1
  Target Bodies(3) = 1 3 4
  Equation = 1
  Material = 1
End

Body 2
  Target Bodies(1) = 2
  Material = 1
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 1
  Density = 1.2
  Viscosity = 1.8e-4
  diffusion coefficient = Real 1.0e-3
  convection coefficient = Real 1.0
  convection velocity 1 = Equals Velocity 1
  convection velocity 2 = Equals Velocity 2
End

Solver 1
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Stabilization Method = Stabilized
  Nonlinear System Max Iterations = 1
  Nonlinear System Convergence Tolerance = 1e-8
  Nonlinear System Newton After Iterations = 1000
  Nonlinear System Newton After Tolerance = 0
  Steady State Convergence Tolerance = 1e-8
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
End

Solver 2
  Equation = String "Tracer"
  Procedure = "ModelPDE" "AdvDiffSolver"
  Variable = Tracer
  Steady State Anderson Skip = Logical True
  Steady State Convergence Tolerance = 1e-8
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
End

! The tracer at the end of every coupled iteration, and once more after the last one: the
! acceleration ends each iteration, so the two last values are equal only if it left the
! tracer alone.
Solver 3
  Exec Solver = Always
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = sweeps.dat
  Variable 1 = Tracer
  Operator 1 = sum
  Operator 2 = min
  Parallel Reduce = True
End

Solver 4
  Exec Solver = After Simulation
  Equation = SaveFinal
  Procedure = "SaveData" "SaveScalars"
  Filename = final.dat
  Variable 1 = Tracer
  Operator 1 = sum
  Operator 2 = min
  Parallel Reduce = True
End

! inlet
Boundary Condition 1
  Target Boundaries(1) = 1
  Velocity 1 = Variable Coordinate 2
    Real MATC "0.3*4*tx*(0.02-tx)/0.0004"
  Velocity 2 = 0
  Tracer = Real 1.0
End

! outlet
Boundary Condition 2
  Target Boundaries(1) = 2
  Velocity 2 = 0
  Tracer = Real 0.0
End

! channel walls and block
Boundary Condition 3
  Target Boundaries(2) = 3 4
  Velocity 1 = 0
  Velocity 2 = 0
End
