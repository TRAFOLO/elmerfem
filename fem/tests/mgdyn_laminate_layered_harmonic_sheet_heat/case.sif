! The loss of lamination sheets in the 'Proximity Loss' of their layered parent elements, from which
! ProcessFields takes the heat load. The model of mgdyn_laminate_layered_harmonic_thick at 50 Hz
! (lamination thickness 0.53 skin depths) with 'Calculate Homogenization Loss': each sheet face's
! loss goes as one density into its two parent elements of the 'layered' block, on top of their
! Im(nu) loss, so that the integral of 'Proximity Loss E' is the laminate stack loss (to 1e-13;
! the sheets' share is 5.5e-4 of it). Columns of scalars.dat: current into the wedge's terminal re,
! im (A), the integral of 'Proximity Loss E' (W), then the res: values; the norms are that integral
! (solver 3) and the laminate stack loss (solver 4).

Check Keywords "Warn"

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Angular Frequency = Real 314.159265359
End

Body 1
  Equation = 1
  Material = 1
End

Body 2
  Equation = 1
  Material = 2
End

Body 3
  Equation = 1
  Material = 3
End

Body 4
  Equation = 1
  Material = 4
End

Body 5
  Equation = 1
  Material = 5
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 1
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 52200000.0
End

Material 3
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 4
  Relative Permeability = 250.0
  Electric Conductivity = 3333333.0
End

Material 5
  Relative Permeability = 250.0
  Electric Conductivity = 0.0
  Laminate Stack Model = String "layered"
  Laminate Thickness = Real 0.0013
  Laminate Stack Conductivity = Real 3333333
  Laminate Stacking Factor = Real 0.722222222222
  Laminate Normal(3) = Real 1 0 0
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV[AV re:1 AV im:1]"
  Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
  Linear System Symmetric = True
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Use Tree Gauge = Logical False
  Mumps Diagonal Regularization = Real 1e-09
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Current Density = Logical True
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True
  Separate Magnetic Energy = Logical True
  Calculate Homogenization Loss = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-8
End

Solver 3
  Exec Solver = after all
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Current Density re e 3
  Operator 1 = boundary int
  Variable 2 = Current Density im e 3
  Operator 2 = boundary int
  Variable 3 = Proximity Loss E
  Operator 3 = int
  Show Norm Index = 3
End

Boundary Condition 1
  Target Boundaries(1) = 1
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 1.0
  AV im = Real 0.0
  Save Scalars = Logical True
End

Boundary Condition 2
  Target Boundaries(1) = 2
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 0.0
  AV im = Real 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 4
  Thin Sheet Laminate Thickness = Real 0.0013
  Thin Sheet Relative Permeability = Real 250.0
  Thin Sheet Electric Conductivity = Real 3333333
End

Solver 4
  Exec Solver = after all
  Equation = "SaveStackLoss"
  Procedure = "SaveData" "SaveScalars"
  Filename = stack.dat
  Show Norm Index = 6
End

Solver 3 :: Reference Norm = Real 9.69682584E+01
Solver 3 :: Reference Norm Tolerance = Real 1.0e-7
Solver 4 :: Reference Norm = Real 9.69682584E+01
Solver 4 :: Reference Norm Tolerance = Real 1.0e-7
