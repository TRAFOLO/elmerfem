! mumps_refinement_row_scale: MumpsRowScale and MumpsBackwardError of the MUMPS refinement
! (DirectSolve) on fixed numbers. A row with next to no activity is measured against its
! block's largest activity, so rounding noise there no longer decides the refinement; rows
! with a real activity are measured against their own.

Check Keywords "Warn"

Header
  Mesh DB "." "square"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
End

Equation 1
  Active Solvers(1) = 1
End

Solver 1
  Equation = "RowScaleTest"
  Procedure = "MumpsRowScaleTest" "MumpsRowScaleTest"
End
