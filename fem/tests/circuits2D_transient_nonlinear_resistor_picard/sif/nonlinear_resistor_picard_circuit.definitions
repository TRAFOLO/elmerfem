! Circuit definitions for circuits2D_transient_nonlinear_resistor_picard.
! A purely lumped loop: ideal voltage source in series with ONE nonlinear
! resistor component. No FEM component is part of the circuit, so there is no
! inductance and the loop current is algebraic at every timestep -- that is
! what makes this test discriminate an implicit (within-timestep Picard)
! nonlinear solve from a scheme that lags the resistance by one timestep.
$ Circuits = 1

! ------------------------ Circuit 1 ------------------------
! Define variable count and initialize circuit matrices.
$ C.1.perm = zeros(4)
$ C.1.perm(0) = 0
$ C.1.perm(1) = 1
$ C.1.perm(2) = 2
$ C.1.perm(3) = 3

$ C.1.variables = 4
$ C.1.A = zeros(4,4)
$ C.1.B = zeros(4,4)
$ C.1.Mre = zeros(4,4)
$ C.1.Mim = zeros(4,4)

! Define variables.
! The exported mesh variable "crt i" collects only the COMPONENT currents, so
! here it is the single-dof variable "crt i" = i_component(1) (the resistor);
! the bare source current is not exported.
$ C.1.name.1 = "i_testsource"
$ C.1.name.2 = "v_testsource"
! The resistor. Elmer writes the component equation R*I - V = 0 to the row of
! the voltage variable (row 4), so it is not written here.
$ C.1.name.3 = "i_component(1)" ! this is the resistor current
$ C.1.name.4 = "v_component(1)" ! this is the resistor voltage

! Define sources:
!------------------
$ C.1.B(0,1) = 1
$ C.1.source.1 = "testsource"

! Define network cycles:
!-------------------------
!Voltage relations.
$ C.1.B(1,1) = -1
$ C.1.B(1,3) = 1
!Current relations.
$ C.1.B(2,0) = 1
$ C.1.B(2,2) = -1
