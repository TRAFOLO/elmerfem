! Within-timestep Picard convergence of a nonlinear lumped circuit element.
!
! Rationale: the DC endpoint of circuits2D_transient_nonlinear_resistor is
! reached even by a scheme that lags the nonlinear resistance by one timestep,
! because the lag vanishes at steady state. This case removes all dynamics so
! that the discrimination happens already at timestep 1 from a cold start.
!
! Circuit: ideal 10 V source in series with ONE lumped resistor whose
! resistance depends on its own current,
!   R(I) = 1 + 0.05*I^2
! via the exported circuit variable "crt i" (Export Circuit Variables).
! Index mapping (verified at runtime with Max Output Level = 20): "crt i"
! exports only the COMPONENT currents, and since there is exactly one
! component it is a single-dof variable named plainly "crt i" (no " 1"
! suffix -- component names are only generated for multi-dof variables).
! No FEM component is part of the circuit, so there is no inductance and the
! exact current at EVERY timestep, timestep 1 included, solves
!   10 = I*(1 + 0.05*I^2)   <=>   0.05*I^3 + I - 10 = 0
!   =>  I* = 4.725131318014795 (A)
! A scheme that lagged the resistance would give I = 10/R(0) = 10 A at the
! first timestep -- grossly different from the asserted value.
!
! The mesh and the MagnetoDynamics2D solver are kept (the circuit equations
! are attached to that solver's Lagrange multipliers) but no body is coupled
! to the circuit, so the field stays at zero.
!
! Based on circuits2D_transient_variable_resistor by Eelis Takala, Trafotek Oy.
Check Keywords "Warn"
INCLUDE sif/nonlinear_resistor_picard_circuit.definitions
INCLUDE 1381/mesh.names
Header 1
   Mesh DB "." "1381"
End
$ stepsize = 1
Simulation 1
   Max Output Level = 5
   Coordinate System = Axi symmetric
   Simulation Type = Transient
   Timestepping Method = BDF
   BDF Order = 1
   Timestep Sizes(1) = $ stepsize
   Timestep Intervals(1) = 3
!  > 1 enables the within-timestep Picard loop over the nonlinear resistance.
!  A minimum count is needed here because this circuit has no FEM-coupled
!  component: the magnetic field stays identically zero, so the field solver
!  -- which is what actually monitors coupled convergence -- reports
!  convergence immediately and would otherwise stop the Picard loop after two
!  iterations. The relaxed iteration below converges in about six.
   Steady State Min Iterations = 15
   Steady State Max Iterations = 30
End
Solver 1
   Exec Solver = Always
   Equation = Circuits
   Procedure = "CircuitsAndDynamics" "CircuitsAndDynamics"
!  Publish the circuit currents/voltages as mesh variables ("crt i", "crt v")
!  so that component keywords may depend on them.
   Export Circuit Variables = Logical True
!  The undamped fixed-point map I <- 10/(1+0.05*I^2) has |g'(I*)| = 1.06 > 1,
!  i.e. it is not a contraction, so plain Picard oscillates. Damping with 0.5
!  makes the effective derivative -0.03 and the loop converges in a few steps.
   Circuit Variable Relaxation Factor = Real 0.5
End
Solver 2
   Equation = "Mag"
   Variable = A
   Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"
   NonLinear System Relaxation Factor=1
   Export Lagrange Multiplier = Logical True
   Linear System Solver = Iterative
   Linear System Iterative Method = bicgstab
   Linear System Convergence Tolerance = 1.e-10
   Linear System Max Iterations = 3000
   Linear System Residual Output = 10
   Linear System Abort not Converged = False
   Linear System ILUT Tolerance=1e-8
   linear system preconditioning = circuit
   BicgStabL Polynomial Degree = 2
   Steady State Convergence Tolerance = 1e-08
!  The field is identically zero here (no coupled component), so a RELATIVE
!  steady-state change is pure round-off noise and would never converge.
   Steady State Convergence Absolute = Logical True
End
Solver 3
   Exec Solver = Never
   Equation = "ResultOutput"
   Procedure = "ResultOutputSolve" "ResultOutputSolver"
   Output File Name = 1381-results
   Vtu format = Logical True
   Save Geometry Ids = Logical True
End
Solver 4
   Exec Solver = Always
   Equation = Circuits Output
   Procedure = "CircuitsAndDynamics" "CircuitsOutput"
End
Solver 5
   Exec Solver = After Timestep
   Equation = "sv"
   Procedure = "SaveData" "SaveScalars"
   Filename = 1381/dat/nonlinear_resistor_picard.dat
!  The resistor current; asserted against the analytic root below.
   Variable 1 = String "crt i"
   Show Norm Index = Integer 1
End
Equation 1
   Active Solvers(2) = 2 3
End
Equation 2
   Active Solvers(3) = 1 2 3
End
Material 1
   Name = iron
   Electric Conductivity = 0
   Relative Permeability = 2000
End
Material 2
   Name = air
   Electric Conductivity = 0
   Relative Permeability = 1
End
Material 3
   Name = aluminium
   Relative Permeability = 1
   Electric Conductivity = 1e7
End
Body 1
   Name = Core
   Target Bodies(6) = 1 2 3 4 5 6
   Equation = 1
   Material = 1
End
Body 2
   Name = air
   Target Bodies(2) = 9 7
   Equation = 1
   Material = 2
End
Body 3
   Name = test 1
   Target Bodies = 8
   Equation = 2
   Material = 3
End
Component 1
   Name = String nonlinear resistor
   Component Type = String Resistor
!  Solution-dependent resistance: depends on this component's own current,
!  the only exported component current ("crt i").
   Resistance = Variable "crt i"
     Real MATC "1.0 + 0.05*tx*tx"
End
Body Force 1
   Name = "Circuit"
   testsource = Real 10
End
Boundary Condition 1
   Target Boundaries(4) = $ center0 center1 center2 center3
   A = Real 0
End
Boundary Condition 2
   Target Boundaries(2) = 4 6
   Name = "Air Gap"
   Air Gap = logical True
   Air Gap Length = Real 0.0001
   Air Gap Relative Permeability = Real 1
End
Boundary Condition 3
   Target Boundaries(7) = 10 13 14 17 18 19 27
   Infinity BC = Logical True
End

Solver 5 :: Reference Norm = 4.725131318014795
Solver 5 :: Reference Norm Tolerance = Real 1E-03
