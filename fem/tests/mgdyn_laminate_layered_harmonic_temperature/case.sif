! The stack conductivity following the temperature. The model of mgdyn_laminate_layered_harmonic_thick
! at 1 kHz (lamination thickness 2.4 skin depths) with an exported Temperature, 20 C at the mid-plane
! rising to 140 C at the bar's end (initial condition), and the conductivity of the 'layered' block
! ('Laminate Stack Conductivity') and of its lamination sheets ('Thin Sheet Electric Conductivity')
! as 3.33 MS/m / (1 + 0.004 (T - 20)): the block's tensor takes it per element, the sheets per face.
! With 20 C everywhere the norm is that of the constant conductivity to the last digit. Norm: the
! laminate stack loss (W).

Check Keywords "Warn"

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Angular Frequency = Real 6283.18530718
End

Body 1
  Equation = 1
  Initial Condition = 1
  Material = 1
End

Body 2
  Equation = 1
  Initial Condition = 1
  Material = 2
End

Body 3
  Equation = 1
  Initial Condition = 1
  Material = 3
End

Body 4
  Equation = 1
  Initial Condition = 1
  Material = 4
End

Body 5
  Equation = 1
  Initial Condition = 1
  Material = 5
End

Initial Condition 1
  Temperature = Variable Coordinate 3
    Real MATC "20+2.0e4*tx"
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 1
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 52200000.0
End

Material 3
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 4
  Relative Permeability = 250.0
  Electric Conductivity = 3333333.0
End

Material 5
  Relative Permeability = 250.0
  Electric Conductivity = 0.0
  Laminate Stack Model = String "layered"
  Laminate Thickness = Real 0.0013
  Laminate Stack Conductivity = Variable Temperature
    Real MATC "3333333/(1+0.004*(tx-20))"
  Laminate Stacking Factor = Real 0.722222222222
  Laminate Normal(3) = Real 1 0 0
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV[AV re:1 AV im:1]"
  Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
  Exported Variable 1 = Temperature
  Linear System Symmetric = True
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Use Tree Gauge = Logical False
  Mumps Diagonal Regularization = Real 1e-09
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Current Density = Logical True
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True
  Separate Magnetic Energy = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-8
End

Solver 3
  Exec Solver = after all
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Current Density re e 3
  Operator 1 = boundary int
  Variable 2 = Current Density im e 3
  Operator 2 = boundary int
  Show Norm Index = 8
End

Boundary Condition 1
  Target Boundaries(1) = 1
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 1.0
  AV im = Real 0.0
  Save Scalars = Logical True
End

Boundary Condition 2
  Target Boundaries(1) = 2
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 0.0
  AV im = Real 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
End

Boundary Condition 4
  Target Boundaries(1) = 4
  Thin Sheet Laminate Thickness = Real 0.0013
  Thin Sheet Relative Permeability = Real 250.0
  Thin Sheet Electric Conductivity = Variable Temperature
    Real MATC "3333333/(1+0.004*(tx-20))"
End

Solver 3 :: Reference Norm = Real 8.14235189E+01
Solver 3 :: Reference Norm Tolerance = Real 1.0e-6
