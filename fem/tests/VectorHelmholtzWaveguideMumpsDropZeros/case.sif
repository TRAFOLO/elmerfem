! The waveguide of VectorHelmholtzWaveguide3 with PEC walls (E {e} = 0) solved by MUMPS
! with "Mumps Drop Zeros": the couplings of the Dirichlet edges are zeroed but stay in the
! sparsity pattern, and the option leaves them out of the matrix given to MUMPS. The norm
! equals that of the same solve without the option, 6.3681411E-03 on 1 and 2 ranks.

Check Keywords "Warn"

Header
  Mesh DB "." "shoebox_hexas"
End

Simulation
  Max Output Level = 5

  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
End

Body 1
  Equation = 1
  Material = 1
End

$ beta0=41.9332032192090
$ k0=52.3961255469564
$ kc=31.4159265358979
$ w=2*pi*(2.5e9)

Material 1
  Relative Permittivity = Real 1
End

Equation 1
  Active Solvers(1) = 1
  Angular Frequency = Real $w
End

Solver 1
  Equation = "VectorHelmholtz"
  Variable = E[E re:1 E im:1]
  Use Piola Transform = Logical False
  Procedure = "VectorHelmholtz" "VectorHelmholtzSolver"

  Nonlinear System Consistent Norm = Logical True
  Linear System Complex = Logical True
  Linear System Symmetric = False
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Mumps Drop Zeros = Logical True
End

! The port: a TE10 wave enters
Boundary Condition 1
  Target Boundaries(1) = 5

  Electric Robin Coefficient im = Real $ beta0
  Magnetic Boundary Load 2 = Variable Coordinate 1
    Real MATC "-2*beta0*k0/kc*sin(pi*tx/100e-3)"
End

! PEC walls and end
Boundary Condition 2
  Target Boundaries(5) = 1 2 3 4 6

  E re {e} = Real 0
  E im {e} = Real 0
End

Solver 1 :: Reference Norm = 6.3681411E-03
Solver 1 :: Reference Norm Tolerance = 1.0e-7
