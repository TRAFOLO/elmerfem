! DEV-1604: the 'layered' laminate stack test (mgdyn_laminate_layered_harmonic) with a saturating
! H-B curve, B = mu0 H + 0.15 T tanh(189 mu0 H / 0.15 T) (initial mu_r 190), at 1 MHz and 1 V: the
! laminations are saturated. The curve is read at their flux density B_par/F + B_perp; the Newton
! term carries the change of the stack tensor with the reluctivity, and the iteration converges as
! fast as for a plain H-B body: to 1e-9 at the 12th solve (the test allows 13). The loss law of the
! stack bodies is evaluated on the laminations' flux density over the metal fraction F of their
! volume; the magnetic energy of the stack is the secant one of its tensor. The lamination sheets
! take the steel's permeability from the curve too, so sheet and body match in saturation.
! Columns of scalars.dat: terminal current re, im (A), eddy current power, electric field energy,
! magnetic field energy, magnetic coenergy, harmonic loss linear, harmonic loss quadratic, joule
! loss, thin sheet power, laminate stack loss. Norms: the laminate stack loss (W, solver 3), the
! loss law (solver 4) and the magnetic field energy (solver 5).

Check Keywords "Warn"

Header
  Mesh DB "." "mesh"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Cartesian"
  Simulation Type = Steady
  Steady State Max Iterations = 1
  Angular Frequency = Real 6283185.30718
End

Body 1
  Equation = 1
  Material = 1
End

Body 2
  Equation = 1
  Material = 2
End

Body 3
  Equation = 1
  Material = 3
End

Body 4
  Equation = 1
  Material = 4
End

Body 5
  Equation = 1
  Material = 5
End

Body 6
  Equation = 1
  Material = 6
End

Equation 1
  Active Solvers(2) = 1 2
End

Material 1
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
  Relative Permittivity = 1.0
End

Material 2
  Relative Permeability = 1.0
  Electric Conductivity = 52200000.0
  Relative Permittivity = 1.0
End

Material 3
  Relative Permeability = 190.0
  Electric Conductivity = 1670000.0
  Relative Permittivity = 1.0
End

Material 4
  H-B Curve = Variable "dummy"
    Real
    0 0
    0.046225596 200
    0.084555344 400
    0.12140161 700
    0.13912545 1000
    0.14931193 1500
    0.15198145 2000
    0.15374746 3000
    0.15628315 5000
    0.16256637 10000
    0.18769911 30000
    0.27566371 100000
    0.52699112 300000
    1.4066371 1000000
    3.9199112 3000000
  End
  Harmonic Loss Linear Coefficient = Real 1.0e-3
  Harmonic Loss Linear Frequency Exponent = Real 1.5
  Harmonic Loss Linear Exponent = Real 1.8
  Electric Conductivity = 0.0
  Relative Permittivity = 1.0
  Laminate Stack Model = String "layered"
  Laminate Thickness = Real 8e-06
  Laminate Stack Conductivity = Real 1670000
  Laminate Stacking Factor = Real 0.9411764706
  Laminate Normal(3) = Real 1 0 0
End

Material 5
  H-B Curve = Variable "dummy"
    Real
    0 0
    0.046225596 200
    0.084555344 400
    0.12140161 700
    0.13912545 1000
    0.14931193 1500
    0.15198145 2000
    0.15374746 3000
    0.15628315 5000
    0.16256637 10000
    0.18769911 30000
    0.27566371 100000
    0.52699112 300000
    1.4066371 1000000
    3.9199112 3000000
  End
  Harmonic Loss Linear Coefficient = Real 1.0e-3
  Harmonic Loss Linear Frequency Exponent = Real 1.5
  Harmonic Loss Linear Exponent = Real 1.8
  Electric Conductivity = 0.0
  Relative Permittivity = 1.0
  Laminate Stack Model = String "layered"
  Laminate Thickness = Real 8e-06
  Laminate Stack Conductivity = Real 1670000
  Laminate Stacking Factor = Real 0.9411764706
  Laminate Normal(3) = Real 0 1 0
End

Material 6
  H-B Curve = Variable "dummy"
    Real
    0 0
    0.046225596 200
    0.084555344 400
    0.12140161 700
    0.13912545 1000
    0.14931193 1500
    0.15198145 2000
    0.15374746 3000
    0.15628315 5000
    0.16256637 10000
    0.18769911 30000
    0.27566371 100000
    0.52699112 300000
    1.4066371 1000000
    3.9199112 3000000
  End
  Harmonic Loss Linear Coefficient = Real 1.0e-3
  Harmonic Loss Linear Frequency Exponent = Real 1.5
  Harmonic Loss Linear Exponent = Real 1.8
  Electric Conductivity = 0.0
  Relative Permittivity = 1.0
  Laminate Stack Model = String "layered"
  Laminate Thickness = Real 8e-06
  Laminate Stack Conductivity = Real 1670000
  Laminate Stacking Factor = Real 0.9411764706
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV[AV re:1 AV im:1]"
  Procedure = "MagnetoDynamics" "WhitneyAVHarmonicSolver"
  Linear System Symmetric = True
  Linear System Solver = "Direct"
  Linear System Direct Method = "MUMPS"
  Use Tree Gauge = Logical False
  Mumps Diagonal Regularization = Real 1.0e-6
  Nonlinear System Convergence Measure = String "flux density"
  Newton-Raphson Iteration = Logical True
  Nonlinear System Max Iterations = 13
  Nonlinear System Convergence Tolerance = 1.0e-9
  Nonlinear System Abort Not Converged = Logical True
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Current Density = Logical True
  Calculate Nodal Fields = Logical False
  Calculate Elemental Fields = Logical True
  Calculate Harmonic Loss = Logical True
  Separate Magnetic Energy = Logical True
  Linear System Solver = "Iterative"
  Linear System Iterative Method = CG
  Linear System Preconditioning = None
  Linear System Max Iterations = 5000
  Linear System Convergence Tolerance = 1.0e-8
End

Solver 3
  Exec Solver = after all
  Equation = "SaveScalars"
  Procedure = "SaveData" "SaveScalars"
  Filename = scalars.dat
  Variable 1 = Current Density re e 3
  Operator 1 = boundary int
  Variable 2 = Current Density im e 3
  Operator 2 = boundary int
  Show Norm Index = 11
End

Solver 4
  Exec Solver = after all
  Equation = "SaveLossLaw"
  Procedure = "SaveData" "SaveScalars"
  Filename = losslaw.dat
  Show Norm Index = 5
End

Solver 5
  Exec Solver = after all
  Equation = "SaveEnergy"
  Procedure = "SaveData" "SaveScalars"
  Filename = energy.dat
  Show Norm Index = 3
End

Boundary Condition 1
  Target Boundaries(1) = 1
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 1.0
  AV im = Real 0.0
  Save Scalars = Logical True
End

Boundary Condition 2
  Target Boundaries(1) = 2
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
  AV re = Real 0.0
  AV im = Real 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  AV re {e} = Real 0.0
  AV im {e} = Real 0.0
End

Boundary Condition 5
  Target Boundaries(1) = 5
  Thin Sheet Laminate Thickness = Real 8e-06
  Thin Sheet Relative Permeability = Real 190
  Thin Sheet Electric Conductivity = Real 1670000
End

Boundary Condition 6
  Target Boundaries(1) = 6
  Thin Sheet Laminate Thickness = Real 8e-06
  Thin Sheet Relative Permeability = Real 190
  Thin Sheet Electric Conductivity = Real 1670000
End

Boundary Condition 7
  Target Boundaries(1) = 7
  Thin Sheet Laminate Thickness = Real 8e-06
  Thin Sheet Relative Permeability = Real 190
  Thin Sheet Electric Conductivity = Real 1670000
End

Solver 3 :: Reference Norm = Real 1.27016717E-02
Solver 3 :: Reference Norm Tolerance = Real 1.0e-5
Solver 4 :: Reference Norm = Real 1.39993897E-06
Solver 4 :: Reference Norm Tolerance = Real 1.0e-5
Solver 5 :: Reference Norm = Real 7.93645227E-06
Solver 5 :: Reference Norm Tolerance = Real 1.0e-5
