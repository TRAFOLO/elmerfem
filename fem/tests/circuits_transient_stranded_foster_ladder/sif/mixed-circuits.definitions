$ Circuits = 2

! Two copies of the single coil's circuit, one per coil, each fed by its own current source.
! ------------------------ Circuit 1 ------------------------
! Define variable count and initialize circuit matrices.
$ C.1.perm = zeros(4)
$ C.1.perm(0) = 0
$ C.1.perm(2) = 1
$ C.1.perm(3) = 2
$ C.1.perm(1) = 3

$ C.1.variables = 4
$ C.1.A = zeros(4,4)
$ C.1.B = zeros(4,4)
$ C.1.Mre = zeros(4,4)
$ C.1.Mim = zeros(4,4)

! Define variables.
$ C.1.name.1 = "i_S"
$ C.1.name.2 = "v_S"
$ C.1.name.3 = "i_component(1)"
$ C.1.name.4 = "v_component(1)"

! Define sources:
!------------------
$ C.1.B(0,0) = 1
$ C.1.source.1 = "S"

! Define network cycles:
!-------------------------
!Voltage relations.
$ C.1.B(1,1) = 1
$ C.1.B(1,3) = -1
!Current relations.
$ C.1.B(2,0) = 1
$ C.1.B(2,2) = 1
! ------------------------ Circuit 2 ------------------------
! Define variable count and initialize circuit matrices.
$ C.2.perm = zeros(4)
$ C.2.perm(0) = 0
$ C.2.perm(2) = 1
$ C.2.perm(3) = 2
$ C.2.perm(1) = 3

$ C.2.variables = 4
$ C.2.A = zeros(4,4)
$ C.2.B = zeros(4,4)
$ C.2.Mre = zeros(4,4)
$ C.2.Mim = zeros(4,4)

! Define variables.
$ C.2.name.1 = "i_S2"
$ C.2.name.2 = "v_S2"
$ C.2.name.3 = "i_component(2)"
$ C.2.name.4 = "v_component(2)"

! Define sources:
!------------------
$ C.2.B(0,0) = 1
$ C.2.source.1 = "S2"

! Define network cycles:
!-------------------------
!Voltage relations.
$ C.2.B(1,1) = 1
$ C.2.B(1,3) = -1
!Current relations.
$ C.2.B(2,0) = 1
$ C.2.B(2,2) = 1