! case startup
$ BDF = 1
$ Nsteps = 60
$ dt = 5.0e-4
! the trapezoid: 0.5 ms edges, 4.5 ms flat, period 10 ms, +-1 A
$ function trapezoid(t) { s = t - 0.01*floor(t/0.01); if (s < 5.0e-4) _trapezoid = s/5.0e-4; else if (s < 5.0e-3) _trapezoid = 1; else if (s < 5.5e-3) _trapezoid = 1 - 2*(s - 5.0e-3)/5.0e-4; else if (s < 0.0095) _trapezoid = -1; else _trapezoid = -1 + (s - 0.0095)/5.0e-4; }
$ function current(t) { if (t < 5.0e-4) _current = t/5.0e-4; else _current = 1.0; }
$ Pref = 1.0
! no pinned value here: runtest.cmake requires the last proximity loss to vanish
$ Ptol = 1e30
